<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mint_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <Button
            android:id="@+id/calcBackButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="@color/pale_rose"
            android:text="← Back"
            android:textAllCaps="false"
            android:textColor="@color/nmims_maroon" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="LAUNDRY PRICE CALCULATOR"
            android:textColor="@color/nmims_maroon"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Official campus rate card synced with Cloud Firestore. Adjust quantities to estimate your total."
            android:textColor="@color/slate"
            android:textSize="14sp" />

        <!-- Rates sync indicator -->
        <TextView
            android:id="@+id/calcSyncBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="● Fetching rates from Firestore…"
            android:textColor="#0E6251"
            android:textSize="12sp" />

        <!-- 1. Wash & Fold Item -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👕  Wash &amp; Fold"
                    android:textColor="@color/nmims_maroon"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/washRateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹10.00 / item"
                    android:textColor="@color/slate"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnWashMinus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/pale_rose"
                    android:text="−"
                    android:textColor="@color/nmims_maroon"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/washQtyText"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnWashPlus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#B9DDFB"
                    android:text="+"
                    android:textColor="@color/navy"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/washSubtotalText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="₹0.00"
                    android:textColor="@color/navy"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Ironing Item -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👔  Steam Ironing"
                    android:textColor="@color/nmims_maroon"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ironRateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹5.00 / item"
                    android:textColor="@color/slate"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnIronMinus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/pale_rose"
                    android:text="−"
                    android:textColor="@color/nmims_maroon"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/ironQtyText"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnIronPlus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#B9DDFB"
                    android:text="+"
                    android:textColor="@color/navy"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/ironSubtotalText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="₹0.00"
                    android:textColor="@color/navy"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Dry Cleaning Item -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🧥  Dry Cleaning"
                    android:textColor="@color/nmims_maroon"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dryRateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹60.00 / item"
                    android:textColor="@color/slate"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDryMinus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/pale_rose"
                    android:text="−"
                    android:textColor="@color/nmims_maroon"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/dryQtyText"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDryPlus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#B9DDFB"
                    android:text="+"
                    android:textColor="@color/navy"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/drySubtotalText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="₹0.00"
                    android:textColor="@color/navy"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. Bedsheets / Linens -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛏️  Bedsheet / Linens"
                    android:textColor="@color/nmims_maroon"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bedsheetRateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹25.00 / item"
                    android:textColor="@color/slate"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBedsheetMinus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/pale_rose"
                    android:text="−"
                    android:textColor="@color/nmims_maroon"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/bedsheetQtyText"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnBedsheetPlus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#B9DDFB"
                    android:text="+"
                    android:textColor="@color/navy"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/bedsheetSubtotalText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="₹0.00"
                    android:textColor="@color/navy"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Grand Total Summary Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total Items Selected:"
                    android:textColor="@color/slate"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/calcTotalItems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 items"
                    android:textColor="@color/navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#E5E7EB" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Estimated Total:"
                    android:textColor="@color/nmims_maroon"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/calcGrandTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0.00"
                    android:textColor="@color/nmims_maroon"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <!-- Information Box explaining Admin-Only Order Placement -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_reminder"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top"
                    android:contentDescription="Notice"
                    android:src="@drawable/ic_bell_reminder" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="This calculator provides a price estimate only. Laundry orders are recorded and confirmed exclusively by the Laundry Administrator when you hand over clothes at the laundry counter."
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnResetCalculator"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/pale_rose"
                android:text="Reset Counts"
                android:textAllCaps="false"
                android:textColor="@color/primary_burgundy"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBackToTracking"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.5"
                android:backgroundTint="@color/primary_burgundy"
                android:text="View My Orders"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
