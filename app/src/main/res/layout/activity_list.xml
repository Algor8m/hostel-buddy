<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="#EFF9F6" android:padding="18dp">
    <TextView android:id="@+id/pageTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Page" android:textSize="26sp" android:textStyle="bold" android:textColor="#8B0028"
        android:paddingBottom="6dp"/>
    <TextView android:id="@+id/pageSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Live updates" android:textColor="#526071" android:paddingBottom="12dp"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/contentText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:padding="16dp" android:textColor="#272333"
            android:textSize="15sp" android:lineSpacingExtra="5dp"/>
    </ScrollView>
    <Button android:id="@+id/backButton" android:layout_width="match_parent" android:layout_height="48dp"
        android:text="Back to dashboard" android:textAllCaps="false" android:layout_marginTop="12dp"/>
</LinearLayout>
